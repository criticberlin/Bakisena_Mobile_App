{
  "expo": {
    "name": "Bakisena",
    "slug": "Bakisena",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo_Only.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/Logo_With_Border.png",
      "resizeMode": "contain",
      "backgroundColor": "#080d4a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Logo_With_Border.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.bakisena.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Logo_Only.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo_With_Border.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080d4a"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bakisena to use your location to find nearby parking spots."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
